# Copy to .env and fill in. Backend settings are in backend/config.py;
# ARDUINO_PORT and CALIBRATION_PATH are used by the Arduino bridge.
# PLANT_ID is used by sensor scripts; the backend identity is in PROFILE_PATH.
# A blank secret switches that part to its offline fallback.

# --- Backend server -------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# The sensor bridges post here, and the Vite dev server proxies to it.
BACKEND_URL=http://127.0.0.1:8000
DEPLOYMENT_MODE=local
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required in remote mode, and must differ. Optional locally.
INGESTION_TOKEN=
VIEWER_TOKEN=

# --- Database --------------------------------------------------------------
# Neon: postgresql://user:password@host/db?sslmode=require
# Local: sqlite:///./plant.db   Blank: bounded in-memory history only.
DATABASE_URL=
DATABASE_REQUIRED=false
# Optional, tests only: a THROWAWAY database (e.g. a Neon test branch) to also run
# tests/test_care_log.py on Postgres. Its tables are dropped. Set it per run, not here.
# TEST_DATABASE_URL=
PROFILE_PATH=shared/plant-profile.json
PLANT_ID=plant-1

# --- ElevenLabs: speech-to-text and the plant's voice ----------------------
ELEVENLABS_API_KEY=
# Free plans can only use default voices via the API; Jessica is playful and warm.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- ASI:One LLM: conversation replies -------------------------------------
ASI_API_KEY=
ASI_MODEL=asi1-mini
ASI_TIMEOUT_S=4

# --- Arduino and touch pad -------------------------------------------------
# Exact port from: python -m backend.sensors.arduino  (e.g. COM3 or /dev/cu.usbmodem...)
ARDUINO_PORT=
CALIBRATION_PATH=config/calibration.json
TOUCH_LISTEN_SECONDS=6
TOUCH_COOLDOWN_SECONDS=10
TOUCH_DEBOUNCE_SECONDS=0.04
# The light gauge shows raw ADC as a share of this maximum, not measured lux.
UI_LIGHT_RAW_MAX=1023

# --- Camera and the hourly care log ---------------------------------------
CAMERA_INDEX=0
# Describe this image file instead of the webcam (for testing without a plant).
# CAMERA_IMAGE=
# Minutes between care-log rows: 60 normally, 1 for a demo.
LOG_INTERVAL_MINUTES=60
# Local time the day gets its label (and old data is purged).
DAY_LABEL_TIME=23:30
# Ollama vision model. llama3.2-vision (Meta) needs ~8 GB of free RAM; moondream runs on
# small laptops but describes less accurately.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=moondream

# --- Plant Care Agent (Agentverse, chat from ASI:One) ----------------------
# Any long random phrase; it fixes the agent's address. Keep it secret.
AGENT_NAME=talking-plant-sprout
AGENT_SEED=
AGENT_PORT=8010

# --- Optional Fetch.ai uAgents mirror --------------------------------------
FETCH_ENABLED=false
FETCH_SEED=
FETCH_TARGET=
