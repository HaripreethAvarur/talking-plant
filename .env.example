# Copy to .env and fill in. Blank speech/LLM API keys enable offline fallbacks.

# ElevenLabs: speech-to-text (Task 3) and the plant's voice (Task 7)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ASI:One LLM: grounded replies (Task 5)
ASI_API_KEY=
ASI_MODEL=asi1-mini
ASI_TIMEOUT_S=4

# Neon Postgres: plant profile and care history (Task 6)
DATABASE_URL=

# Fetch.ai Plant Care Agent (Task 4)
AGENT_SEED=

# Plant identity
PLANT_NAME=Sprout
PLANT_SPECIES=pothos

# UI bridge server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Unified backend / native bridges (the frontend Vite proxy reads BACKEND_URL).
BACKEND_URL=http://127.0.0.1:8000
PORT=8000
PLANT_ID=plant-1
DATABASE_REQUIRED=false
PROFILE_PATH=shared/plant-profile.json
DEPLOYMENT_MODE=local
INGESTION_TOKEN=
VIEWER_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_MODE=false
# Copy exact USB path from make arduino-devices. Our sketch uses 115200 baud.
ARDUINO_PORT=
CALIBRATION_PATH=config/calibration.json
TOUCH_LISTEN_SECONDS=6
TOUCH_COOLDOWN_SECONDS=10
TOUCH_DEBOUNCE_SECONDS=0.04
# Display percentage is normalized ADC range, not measured lux.
UI_LIGHT_RAW_MAX=1023
CAMERA_INDEX=0
# Optional Fetch runtime, independent of sensors and speech.
FETCH_ENABLED=false
FETCH_SEED=
FETCH_TARGET=
