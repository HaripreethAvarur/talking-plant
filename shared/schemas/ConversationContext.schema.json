          "title": "Leaf Stale Seconds",
          "type": "number"
        },
        "soggy_enter": {
          "default": 90,
          "maximum": 100,
          "minimum": 0,
          "title": "Soggy Enter",
          "type": "number"
        },
        "soggy_exit": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "title": "Soggy Exit",
          "type": "number"
        },
        "soggy_seconds": {
          "default": 120,
          "description": "how long soil must stay very wet",
          "minimum": 0,
          "title": "Soggy Seconds",
          "type": "number"
        },
        "night_start_hour": {
          "default": 21,
