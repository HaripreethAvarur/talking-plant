        "leaf_color_exit": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Leaf Color Exit",
          "type": "number"
        },
        "leaf_confirmations": {
          "default": 2,
          "minimum": 1,
          "title": "Leaf Confirmations",
          "type": "integer"
        },
        "leaf_stale_seconds": {
          "default": 300,
