{
  "$defs": {
    "HourlyReading": {
      "additionalProperties": false,
      "description": "One row per plant per logging interval (an hour normally; a minute in demos).\n`hour` is the interval's start. mood is ASI's label for it; day_mood is set only on\nthe last row of each day, by the nightly job, and feeds the leaderboard.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z0-9_.-]{2,32}$",
          "title": "Username",
          "type": "string"
        },
        "hour": {
          "format": "date-time",
          "title": "Hour",
          "type": "string"
        },
        "sun_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sun Pct"
        },
        "water_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Water Pct"
        },
        "air_aqi": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Air Aqi"
        },
        "health": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ollama's description of the photo",
          "title": "Health"
        },
        "mood": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mood"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "day_mood": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mood"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "username",
        "hour"
      ],
      "title": "HourlyReading",
      "type": "object"
    },
    "LeafObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "plant_id": {
          "default": "plant-1",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Plant Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "source": {
          "enum": [
            "mock",
            "replay",
            "hardware",
            "image_file"
          ],
          "title": "Source",
          "type": "string"
        },
        "device_id": {
          "default": "simulator",
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "yellow_proportion": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yellow Proportion"
        },
        "brown_proportion": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brown Proportion"
        },
        "method": {
          "default": "hsv-color-v1",
          "title": "Method",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "note": {
          "default": "Color observation only; not a diagnosis or probability.",
          "maxLength": 1000,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "source",
        "status"
      ],
      "title": "LeafObservation",
      "type": "object"
    },
