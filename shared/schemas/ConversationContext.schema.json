          "maximum": 23,
          "minimum": 0,
          "title": "Night Start Hour",
          "type": "integer"
        },
        "night_end_hour": {
          "default": 7,
          "maximum": 23,
          "minimum": 0,
          "title": "Night End Hour",
          "type": "integer"
