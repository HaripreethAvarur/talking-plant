        },
        "watering_sustain": {
          "default": 2,
          "minimum": 0,
          "title": "Watering Sustain",
          "type": "number"
        },
        "watering_cooldown": {
          "default": 30,
          "minimum": 0,
          "title": "Watering Cooldown",
          "type": "number"
        },
        "grateful_seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Grateful Seconds",
          "type": "number"
        },
        "speech_cooldown": {
          "default": 30,
          "minimum": 0,
