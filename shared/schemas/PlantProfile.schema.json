{
  "$defs": {
    "PlantType": {
      "description": "Moisture needs differ by category; per-species thresholds aren't publicly available.",
      "enum": [
        "succulent",
        "plant",
        "tree"
      ],
      "title": "PlantType",
      "type": "string"
    },
    "Thresholds": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "dry_enter": {
          "default": 30,
          "maximum": 100,
          "minimum": 0,
          "title": "Dry Enter",
          "type": "number"
        },
        "dry_exit": {
          "default": 40,
          "maximum": 100,
          "minimum": 0,
          "title": "Dry Exit",
          "type": "number"
        },
        "dry_seconds": {
          "default": 3,
          "minimum": 0,
          "title": "Dry Seconds",
          "type": "number"
        },
        "dark_enter": {
          "default": 200,
          "minimum": 0,
          "title": "Dark Enter",
          "type": "number"
        },
        "dark_exit": {
          "default": 300,
          "minimum": 0,
          "title": "Dark Exit",
          "type": "number"
        },
        "light_unit": {
          "default": "raw",
          "enum": [
            "lux",
            "raw"
          ],
          "title": "Light Unit",
          "type": "string"
        },
        "dark_seconds": {
          "default": 3,
          "minimum": 0,
          "title": "Dark Seconds",
          "type": "number"
        },
        "watering_rise": {
          "default": 20,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Watering Rise",
          "type": "number"
        },
        "watering_window": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Watering Window",
          "type": "number"
        },
        "watering_sustain": {
          "default": 2,
          "minimum": 0,
          "title": "Watering Sustain",
          "type": "number"
        },
        "watering_cooldown": {
          "default": 30,
          "minimum": 0,
          "title": "Watering Cooldown",
          "type": "number"
        },
        "grateful_seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Grateful Seconds",
          "type": "number"
        },
        "speech_cooldown": {
          "default": 30,
          "minimum": 0,
          "title": "Speech Cooldown",
          "type": "number"
        },
        "stale_seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Stale Seconds",
          "type": "number"
        },
        "smoothing_samples": {
          "default": 3,
          "maximum": 60,
          "minimum": 1,
          "title": "Smoothing Samples",
          "type": "integer"
        },
        "leaf_color_enter": {
          "default": 0.35,
          "maximum": 1,
          "minimum": 0,
          "title": "Leaf Color Enter",
          "type": "number"
        },
        "leaf_color_exit": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Leaf Color Exit",
          "type": "number"
        },
        "leaf_confirmations": {
          "default": 2,
          "minimum": 1,
          "title": "Leaf Confirmations",
          "type": "integer"
        },
        "leaf_stale_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Leaf Stale Seconds",
          "type": "number"
        },
        "soggy_enter": {
          "default": 90,
          "maximum": 100,
          "minimum": 0,
          "title": "Soggy Enter",
          "type": "number"
        },
        "soggy_exit": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "title": "Soggy Exit",
          "type": "number"
        },
        "soggy_seconds": {
          "default": 120,
          "description": "how long soil must stay very wet",
          "minimum": 0,
          "title": "Soggy Seconds",
          "type": "number"
        },
        "night_start_hour": {
          "default": 21,
          "description": "local time; dark is normal from here",
          "maximum": 23,
          "minimum": 0,
          "title": "Night Start Hour",
          "type": "integer"
        },
        "night_end_hour": {
          "default": 7,
          "maximum": 23,
          "minimum": 0,
          "title": "Night End Hour",
          "type": "integer"
        }
      },
      "title": "Thresholds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plant_id": {
      "default": "plant-1",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Plant Id",
      "type": "string"
    },
    "name": {
      "default": "Sprout",
      "title": "Name",
      "type": "string"
    },
    "species": {
      "default": "pothos",
      "title": "Species",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    },
    "username": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.-]{2,32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Username"
    },
    "plant_type": {
      "$ref": "#/$defs/PlantType",
      "default": "plant"
    },
    "timezone": {
      "default": "America/Detroit",
      "title": "Timezone",
      "type": "string"
    }
  },
  "title": "PlantProfile",
  "type": "object"
}
