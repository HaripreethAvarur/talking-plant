          "title": "Schema Version",
          "type": "string"
        },
        "dry_enter": {
          "default": 30,
          "maximum": 100,
          "minimum": 0,
          "title": "Dry Enter",
          "type": "number"
        },
        "dry_exit": {
          "default": 40,
          "maximum": 100,
          "minimum": 0,
          "title": "Dry Exit",
          "type": "number"
        },
        "dry_seconds": {
          "default": 3,
          "minimum": 0,
          "title": "Dry Seconds",
          "type": "number"
        },
        "dark_enter": {
          "default": 100,
          "minimum": 0,
          "title": "Dark Enter",
          "type": "number"
        },
        "dark_exit": {
          "default": 150,
          "minimum": 0,
          "title": "Dark Exit",
          "type": "number"
        },
        "light_unit": {
          "default": "lux",
