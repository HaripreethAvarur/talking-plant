{
  "$defs": {
    "Status": {
      "enum": [
        "ok",
        "missing",
        "disconnected",
        "stale",
        "error",
        "uncalibrated"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "plant_id": {
      "default": "plant-1",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Plant Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "source": {
      "enum": [
        "mock",
        "replay",
        "hardware",
        "image_file"
      ],
      "title": "Source",
      "type": "string"
    },
    "device_id": {
      "default": "simulator",
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "yellow_proportion": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Yellow Proportion"
    },
    "brown_proportion": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brown Proportion"
    },
    "method": {
      "default": "hsv-color-v1",
      "title": "Method",
      "type": "string"
    },
    "region": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "note": {
      "default": "Color observation only; not a diagnosis or probability.",
      "maxLength": 1000,
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "source",
    "status"
  ],
  "title": "LeafObservation",
  "type": "object"
}
